<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:upeko"
             x:Class="upeko.App"
             RequestedThemeVariant="Light">

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceInclude x:Key="Lang_en-US" Source="avares://upeko/Assets/Lang/Strings.en-US.axaml"/>
            <ResourceInclude x:Key="Lang_fr" Source="avares://upeko/Assets/Lang/Strings.fr.axaml"/>
            <ResourceInclude x:Key="Lang_de" Source="avares://upeko/Assets/Lang/Strings.de.axaml"/>
            <ResourceInclude x:Key="Lang_es" Source="avares://upeko/Assets/Lang/Strings.es.axaml"/>
            <ResourceInclude x:Key="Lang_pl" Source="avares://upeko/Assets/Lang/Strings.pl.axaml"/>
            <ResourceInclude x:Key="Lang_ru" Source="avares://upeko/Assets/Lang/Strings.ru.axaml"/>
            <ResourceInclude x:Key="Lang_zh-Hans" Source="avares://upeko/Assets/Lang/Strings.zh-Hans.axaml"/>
            <!-- NadeKloud logo, drawn from ndkloud's favicon.svg (seal with a sakura flower) -->
            <DrawingImage x:Key="NadeKloudLogo">
                <DrawingGroup>
                    <GeometryDrawing Geometry="M0,0 H32 V24.96 L24.96,32 H0 Z">
                        <GeometryDrawing.Brush>
                            <LinearGradientBrush StartPoint="5.07,-2.93" EndPoint="26.93,34.93">
                                <GradientStop Offset="0" Color="#e0457e"/>
                                <GradientStop Offset="1" Color="#a8124c"/>
                            </LinearGradientBrush>
                        </GeometryDrawing.Brush>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="#8CFFFFFF"
                                     Geometry="M16.000,15.480 L13.400,8.720 L14.310,7.160 L15.220,8.200 L16.000,6.640 L16.780,8.200 L17.690,7.160 L18.600,8.720 Z M16.495,15.839 L22.120,11.278 L23.885,11.661 L23.177,12.848 L24.902,13.108 L23.659,14.331 L24.930,14.876 L23.727,16.223 Z M16.306,16.421 L22.383,20.361 L22.563,22.158 L21.216,21.852 L21.502,23.572 L19.954,22.769 L19.829,24.145 L18.176,23.418 Z M15.694,16.421 L13.824,23.418 L12.171,24.145 L12.046,22.769 L10.498,23.572 L10.784,21.852 L9.437,22.158 L9.617,20.361 Z M15.505,15.839 L8.273,16.223 L7.070,14.876 L8.341,14.331 L7.098,13.108 L8.823,12.848 L8.115,11.661 L9.880,11.278 Z">
                        <GeometryDrawing.Pen>
                            <Pen Brush="White" Thickness="2.08" LineCap="Round" LineJoin="Round"/>
                        </GeometryDrawing.Pen>
                    </GeometryDrawing>
                    <GeometryDrawing Brush="White">
                        <GeometryDrawing.Geometry>
                            <EllipseGeometry Center="16,16" RadiusX="1.82" RadiusY="1.82"/>
                        </GeometryDrawing.Geometry>
                    </GeometryDrawing>
                </DrawingGroup>
            </DrawingImage>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackground" Color="#ffffff"/>
                    <SolidColorBrush x:Key="SecondaryBackground" Color="#fafafa"/>
                    <SolidColorBrush x:Key="TertiaryBackground" Color="#f5f5f5"/>
                    <SolidColorBrush x:Key="TextPrimary" Color="#000000"/>
                    <SolidColorBrush x:Key="TextSecondary" Color="#666666"/>
                    <SolidColorBrush x:Key="TextTertiary" Color="#8a8a8a"/>
                    <SolidColorBrush x:Key="BorderColor" Color="#eaeaea"/>
                    <SolidColorBrush x:Key="BorderColorStrong" Color="#d6d6d6"/>
                    <SolidColorBrush x:Key="AccentColor" Color="#0070f3"/>
                    <SolidColorBrush x:Key="SuccessColor" Color="#50e3c2"/>
                    <SolidColorBrush x:Key="WarningColor" Color="#f5a623"/>
                    <SolidColorBrush x:Key="ErrorColor" Color="#e5484d"/>
                    <SolidColorBrush x:Key="HoverBackground" Color="#05000000"/>
                    <SolidColorBrush x:Key="CardShadowColor" Color="#0a000000"/>
                    <SolidColorBrush x:Key="ModalBackdrop" Color="#66000000"/>
                    <SolidColorBrush x:Key="BtnSecondaryBg" Color="#000000"/>
                    <SolidColorBrush x:Key="BtnSecondaryFg" Color="#ffffff"/>
                    <SolidColorBrush x:Key="AccentBgSubtle" Color="#190070f3"/>
                    <SolidColorBrush x:Key="ErrorBgSubtle" Color="#0de5484d"/>
                    <SolidColorBrush x:Key="ErrorBorderSubtle" Color="#33e5484d"/>
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackground" Color="#000000"/>
                    <SolidColorBrush x:Key="SecondaryBackground" Color="#111111"/>
                    <SolidColorBrush x:Key="TertiaryBackground" Color="#1a1a1a"/>
                    <SolidColorBrush x:Key="TextPrimary" Color="#ffffff"/>
                    <SolidColorBrush x:Key="TextSecondary" Color="#888888"/>
                    <SolidColorBrush x:Key="TextTertiary" Color="#6e6e6e"/>
                    <SolidColorBrush x:Key="BorderColor" Color="#222222"/>
                    <SolidColorBrush x:Key="BorderColorStrong" Color="#333333"/>
                    <SolidColorBrush x:Key="AccentColor" Color="#3291ff"/>
                    <SolidColorBrush x:Key="SuccessColor" Color="#50e3c2"/>
                    <SolidColorBrush x:Key="WarningColor" Color="#f5a623"/>
                    <SolidColorBrush x:Key="ErrorColor" Color="#e5484d"/>
                    <SolidColorBrush x:Key="HoverBackground" Color="#0dffffff"/>
                    <SolidColorBrush x:Key="CardShadowColor" Color="#66000000"/>
                    <SolidColorBrush x:Key="ModalBackdrop" Color="#99000000"/>
                    <SolidColorBrush x:Key="BtnSecondaryBg" Color="#ffffff"/>
                    <SolidColorBrush x:Key="BtnSecondaryFg" Color="#000000"/>
                    <SolidColorBrush x:Key="AccentBgSubtle" Color="#193291ff"/>
                    <SolidColorBrush x:Key="ErrorBgSubtle" Color="#0de5484d"/>
                    <SolidColorBrush x:Key="ErrorBorderSubtle" Color="#33e5484d"/>
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />

        <!-- Card Style -->
        <Style Selector="Border.card">
            <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="ClipToBounds" Value="True"/>
        </Style>

        <!-- Ghost Button -->
        <Style Selector="Button.btn-ghost">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.btn-ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <!-- Primary Button -->
        <Style Selector="Button.btn-primary">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.btn-primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource AccentColor}"/>
            <Setter Property="Opacity" Value="0.9"/>
        </Style>

        <!-- Secondary Button -->
        <Style Selector="Button.btn-secondary">
            <Setter Property="Background" Value="{DynamicResource BtnSecondaryBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnSecondaryFg}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.btn-secondary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource BtnSecondaryBg}"/>
            <Setter Property="Foreground" Value="{DynamicResource BtnSecondaryFg}"/>
            <Setter Property="Opacity" Value="0.85"/>
        </Style>

        <!-- Danger Button -->
        <Style Selector="Button.btn-danger">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ErrorColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.btn-danger:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ErrorColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorColor}"/>
        </Style>

        <!-- Themed TextBox -->
        <Style Selector="TextBox.input">
            <Setter Property="Background" Value="{DynamicResource TertiaryBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="12,0"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style Selector="TextBox.input:focus /template/ Border#PART_BorderElement">
            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}"/>
        </Style>

        <!-- Small ghost button -->
        <Style Selector="Button.btn-ghost-sm">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8,2"/>
            <Setter Property="Height" Value="24"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="FontWeight" Value="Normal"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.btn-ghost-sm:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
        </Style>

        <!-- Shortcut button -->
        <Style Selector="Button.shortcut-btn">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.shortcut-btn:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TertiaryBackground}"/>
        </Style>

        <!-- List row -->
        <Style Selector="Button.list-row">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.list-row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource TertiaryBackground}"/>
        </Style>

        <!-- Icon button (compact, for inline actions) -->
        <Style Selector="Button.btn-icon">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.btn-icon:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource HoverBackground}"/>
        </Style>

        <!-- Disabled flat buttons fade instead of getting Fluent's grey fill -->
        <Style Selector="Button.btn-ghost:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.shortcut-btn:disabled /template/ ContentPresenter#PART_ContentPresenter, Button.btn-ghost-sm:disabled /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent"/>
        </Style>
        <Style Selector="Button.btn-ghost:disabled, Button.shortcut-btn:disabled, Button.btn-ghost-sm:disabled">
            <Setter Property="Opacity" Value="0.45"/>
        </Style>

        <!-- Toast (a button so a click dismisses it) -->
        <Style Selector="Button.toast">
            <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColorStrong}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,12"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.toast:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource SecondaryBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColorStrong}"/>
        </Style>
        <Style Selector="Button.toast:pressed">
            <Setter Property="RenderTransform" Value="none"/>
        </Style>

        <!-- NadeKloud card and strip on the bot list -->
        <Style Selector="Border.cloud-strip">
            <Setter Property="Background" Value="{DynamicResource SecondaryBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="16,10"/>
        </Style>

        <!-- Footer links -->
        <Style Selector="Button.footer-icon">
            <Setter Property="Width" Value="28"/>
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="MinWidth" Value="0"/>
            <Setter Property="MinHeight" Value="0"/>
        </Style>
        <Style Selector="Button.footer-link">
            <Setter Property="Height" Value="28"/>
            <Setter Property="Padding" Value="6,0"/>
            <Setter Property="MinHeight" Value="0"/>
            <Setter Property="FontSize" Value="12"/>
        </Style>

        <!-- "Newer version" pill in the footer -->
        <Style Selector="Button.update-pill">
            <Setter Property="Background" Value="#2f9e44"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="Button.update-pill:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="#2b8a3e"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>

        <!-- Small danger button -->
        <Style Selector="Button.btn-danger-sm">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource ErrorColor}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorColor}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="16,0"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style Selector="Button.btn-danger-sm:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="{DynamicResource ErrorColor}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ErrorColor}"/>
        </Style>
    </Application.Styles>
</Application>