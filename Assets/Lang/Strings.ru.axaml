<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

    <!-- App / MainWindow -->
    <x:String x:Key="App_Name">Upeko</x:String>
    <x:String x:Key="MainWindow_Title">Upeko — Менеджер ботов</x:String>
    <x:String x:Key="MainWindow_MinimizeToTrayTip">Сворачивать в трей при закрытии</x:String>
    <x:String x:Key="MainWindow_ToggleThemeTip">Сменить тему</x:String>
    <x:String x:Key="MainWindow_DiscordTip">Присоединиться к серверу Nadeko Bot в Discord</x:String>
    <x:String x:Key="MainWindow_NewerVersion">Новая версия</x:String>
    <x:String x:Key="MainWindow_NewerVersionTip">Нажмите, чтобы скачать последнюю версию Upeko</x:String>

    <!-- Delete Modal -->
    <x:String x:Key="Modal_DeleteTitle">Удалить экземпляр</x:String>
    <x:String x:Key="Modal_DeletePrefix">Вы уверены, что хотите удалить </x:String>
    <x:String x:Key="Modal_DeleteSuffix">? Это действие нельзя отменить.</x:String>
    <x:String x:Key="Modal_Cancel">Отмена</x:String>
    <x:String x:Key="Modal_Delete">Удалить</x:String>

    <!-- Exit Modal -->
    <x:String x:Key="Modal_ExitTitle">Боты всё ещё работают</x:String>
    <x:String x:Key="Modal_QuitAnyway">Выйти в любом случае</x:String>

    <!-- Tray -->
    <x:String x:Key="Tray_Show">Показать Upeko</x:String>
    <x:String x:Key="Tray_Exit">Выход</x:String>
    <x:String x:Key="Tray_Tooltip">Upeko</x:String>
    <x:String x:Key="Tray_MinimizedNotification">Upeko свёрнут в трей и продолжит работу в фоновом режиме</x:String>

    <!-- Bot List View -->
    <x:String x:Key="BotList_PageTitle">Экземпляры</x:String>
    <x:String x:Key="BotList_PageSubtitle">Управляйте экземплярами NadekoBot</x:String>
    <x:String x:Key="BotList_Changelog">Журнал изменений</x:String>
    <x:String x:Key="BotList_AddInstance">Добавить экземпляр</x:String>
    <x:String x:Key="BotList_Start">Запустить</x:String>
    <x:String x:Key="BotList_Stop">Остановить</x:String>
    <x:String x:Key="BotList_Download">Скачать</x:String>
    <x:String x:Key="BotList_Update">Обновить</x:String>
    <x:String x:Key="BotList_EmptyTitle">Экземпляры не найдены</x:String>
    <x:String x:Key="BotList_EmptySubtitle">Начните с создания нового экземпляра бота.</x:String>
    <x:String x:Key="BotList_CreateInstance">Создать экземпляр</x:String>

    <!-- Bot View -->
    <x:String x:Key="BotView_BackToInstances">Назад к экземплярам</x:String>
    <x:String x:Key="BotView_ChangeAvatarTip">Нажмите, чтобы сменить аватар</x:String>
    <x:String x:Key="BotView_ClickToRenameTip">Нажмите, чтобы переименовать</x:String>
    <x:String x:Key="BotView_SaveTip">Сохранить</x:String>
    <x:String x:Key="BotView_CancelTip">Отмена</x:String>
    <x:String x:Key="BotView_Configuration">Конфигурация</x:String>
    <x:String x:Key="BotView_InstallPath">ПУТЬ УСТАНОВКИ</x:String>
    <x:String x:Key="BotView_Browse">Обзор</x:String>
    <x:String x:Key="BotView_Actions">Действия</x:String>
    <x:String x:Key="BotView_StopInstance">Остановить экземпляр</x:String>
    <x:String x:Key="BotView_Start">Запустить</x:String>
    <x:String x:Key="BotView_DownloadInstall">Скачать и установить</x:String>
    <x:String x:Key="BotView_CancelDownload">Отменить скачивание</x:String>
    <x:String x:Key="BotView_Shortcuts">Ярлыки</x:String>
    <x:String x:Key="BotView_DataFolder">Папка данных</x:String>
    <x:String x:Key="BotView_OpenInFileManager">Открыть в файловом менеджере</x:String>
    <x:String x:Key="BotView_OpenConfiguration">Открыть конфигурацию</x:String>
    <x:String x:Key="BotView_DangerZone">ОПАСНАЯ ЗОНА</x:String>
    <x:String x:Key="BotView_DangerDescription">Удаляет этот экземпляр из Upeko. Файлы бота остаются на диске: удалите его папку сами, если она больше не нужна.</x:String>
    <x:String x:Key="BotView_DeleteInstance">Удалить экземпляр</x:String>
    <x:String x:Key="BotView_SelectBotPath">Выберите путь бота</x:String>
    <x:String x:Key="BotView_SelectAvatarImage">Выберите изображение аватара</x:String>
    <x:String x:Key="BotView_ImageFiles">Файлы изображений</x:String>

    <!-- Status Text -->
    <x:String x:Key="Status_Running">Работает</x:String>
    <x:String x:Key="Status_Ready">Готов</x:String>
    <x:String x:Key="Status_UpdateAvailable">Доступно обновление</x:String>
    <x:String x:Key="Status_NotDownloaded">Не скачан</x:String>
    <x:String x:Key="Status_Unknown">Неизвестно</x:String>

    <!-- Update Button -->
    <x:String x:Key="BotView_Checking">Проверка...</x:String>
    <x:String x:Key="BotView_UpdateButton">Обновить</x:String>
    <x:String x:Key="BotView_CheckUpdates">Проверить обновления</x:String>

    <!-- Download Progress -->
    <x:String x:Key="Progress_Downloading">Скачивание...</x:String>
    <x:String x:Key="Progress_PleaseWait">Подождите, не закрывайте приложение.</x:String>
    <x:String x:Key="Progress_Stalled">Нет прогресса</x:String>
    <x:String x:Key="Progress_Calculating">Вычисление...</x:String>

    <!-- Dependency Status -->

    <!-- Toast Messages -->
    <x:String x:Key="Toast_InstanceCreated">Экземпляр создан</x:String>
    <x:String x:Key="Toast_InstanceDeleted">Экземпляр удалён</x:String>
    <x:String x:Key="Toast_RecoveredFromBackup">Настройки были повреждены и восстановлены из резервной копии</x:String>
    <x:String x:Key="Toast_ResumingBots">Запуск ботов прошлой сессии: {0}</x:String>

    <!-- Notices and errors -->
    <x:String x:Key="Modal_ExitMessage">Запущено ботов: {0}. Если закрыть Upeko, они остановятся. Они снова запустятся при следующем открытии Upeko.</x:String>
    <x:String x:Key="Progress_DownloadingVersion">Скачивание NadekoBot {0}...</x:String>
    <x:String x:Key="Progress_Extracting">Распаковка...</x:String>
    <x:String x:Key="Progress_Installing">Установка...</x:String>
    <x:String x:Key="BotView_DiskSpace">нужно ~{0} · свободно {1}</x:String>
    <x:String x:Key="Dep_TipInstalled">{0} установлен</x:String>
    <x:String x:Key="Dep_TipMissing">{0} не найден. Нажмите, чтобы установить (нужен для музыки).</x:String>
    <x:String x:Key="Dep_TipChecking">Проверка {0}...</x:String>
    <x:String x:Key="Toast_InstallingDep">Установка {0}...</x:String>
    <x:String x:Key="Toast_DepInstalled">{0} установлен</x:String>
    <x:String x:Key="Toast_DepInstallFailed">Не удалось установить {0}. Подробности в журнале.</x:String>
    <x:String x:Key="Toast_FfmpegMacBrew">Установите ffmpeg через Homebrew: brew install ffmpeg</x:String>
    <x:String x:Key="Toast_StartFailed">Не удалось запустить {0}: {1}</x:String>
    <x:String x:Key="Toast_BotExited">{0} неожиданно остановился</x:String>
    <x:String x:Key="Toast_CredsMissing">Файл creds_example.yml не найден. Сначала скачайте бота.</x:String>
    <x:String x:Key="Toast_OpenFailed">Не удалось открыть: {0}</x:String>
    <x:String x:Key="Toast_UpdateCheckFailed">Не удалось проверить обновления: {0}</x:String>
    <x:String x:Key="Toast_UpToDate">У вас последняя версия NadekoBot</x:String>
    <x:String x:Key="Toast_StopBeforeUpdate">Остановите бота перед обновлением</x:String>
    <x:String x:Key="Toast_BotInstalled">{0} готов (v{1})</x:String>
    <x:String x:Key="Toast_DownloadCancelled">Скачивание отменено</x:String>
    <x:String x:Key="Toast_DownloadFailed">Не удалось скачать: {0}</x:String>
    <x:String x:Key="Error_DownloadInProgress">Уже идёт другое скачивание. Дождитесь его завершения.</x:String>
    <x:String x:Key="Error_NoAssets">У последней версии NadekoBot пока нет файлов для скачивания. Попробуйте позже.</x:String>
    <x:String x:Key="Error_NoAssetForPlatform">Для этой системы нет сборки последней версии NadekoBot ({0}).</x:String>
    <x:String x:Key="Error_RootFolder">Выберите для бота папку, а не корень диска.</x:String>
    <x:String x:Key="Error_NotEnoughSpace">Недостаточно места на диске: нужно {0}, свободно {1}. Освободите место или выберите другую папку.</x:String>
    <x:String x:Key="Error_Extract">Не удалось распаковать скачанный файл: {0}</x:String>

    <!-- Patreon and NadeKloud -->
    <x:String x:Key="MainWindow_PatreonTip">Поддержать Nadeko на Patreon</x:String>
    <x:String x:Key="MainWindow_CloudTip">NadeKloud: управляемый хостинг NadekoBot</x:String>
    <x:String x:Key="Cloud_StripText">Не хотите держать бота сами? Мы размещаем вашего бота 24/7 и можем перенести вашу папку data.</x:String>
    <x:String x:Key="Cloud_MoveBot">Перенести бота</x:String>
    <x:String x:Key="Cloud_HideTip">Скрыть на 30 дней</x:String>
    <x:String x:Key="Cloud_Or">или</x:String>
    <x:String x:Key="Cloud_CardTitle">Доверьте хостинг нам</x:String>
    <x:String x:Key="Cloud_CardText">NadeKloud держит вашего собственного NadekoBot онлайн 24/7. Не нужен свой сервер, обновления и ночные резервные копии мы берём на себя. Бесплатный пробный период, без карты.</x:String>
    <x:String x:Key="Cloud_TryFree">Попробовать бесплатно</x:String>
</ResourceDictionary>
