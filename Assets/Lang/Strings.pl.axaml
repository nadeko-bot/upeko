<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

    <!-- App / MainWindow -->
    <x:String x:Key="App_Name">Upeko</x:String>
    <x:String x:Key="MainWindow_Title">Upeko — Menedżer botów</x:String>
    <x:String x:Key="MainWindow_MinimizeToTrayTip">Minimalizuj do zasobnika przy zamykaniu</x:String>
    <x:String x:Key="MainWindow_ToggleThemeTip">Zmień motyw</x:String>
    <x:String x:Key="MainWindow_DiscordTip">Dołącz do Discorda Nadeko Bot</x:String>
    <x:String x:Key="MainWindow_NewerVersion">Nowsza wersja</x:String>
    <x:String x:Key="MainWindow_NewerVersionTip">Kliknij, aby pobrać najnowszą wersję Upeko</x:String>

    <!-- Delete Modal -->
    <x:String x:Key="Modal_DeleteTitle">Usuń instancję</x:String>
    <x:String x:Key="Modal_DeletePrefix">Czy na pewno chcesz usunąć </x:String>
    <x:String x:Key="Modal_DeleteSuffix">? Tej operacji nie można cofnąć.</x:String>
    <x:String x:Key="Modal_Cancel">Anuluj</x:String>
    <x:String x:Key="Modal_Delete">Usuń</x:String>

    <!-- Exit Modal -->
    <x:String x:Key="Modal_ExitTitle">Boty nadal działają</x:String>
    <x:String x:Key="Modal_QuitAnyway">Wyjdź mimo to</x:String>

    <!-- Tray -->
    <x:String x:Key="Tray_Show">Pokaż Upeko</x:String>
    <x:String x:Key="Tray_Exit">Wyjdź</x:String>
    <x:String x:Key="Tray_Tooltip">Upeko</x:String>
    <x:String x:Key="Tray_MinimizedNotification">Upeko zostało przeniesione do zasobnika i będzie działać w tle</x:String>

    <!-- Bot List View -->
    <x:String x:Key="BotList_PageTitle">Instancje</x:String>
    <x:String x:Key="BotList_PageSubtitle">Zarządzaj swoimi instancjami NadekoBot</x:String>
    <x:String x:Key="BotList_Changelog">Dziennik zmian</x:String>
    <x:String x:Key="BotList_AddInstance">Dodaj instancję</x:String>
    <x:String x:Key="BotList_Start">Uruchom</x:String>
    <x:String x:Key="BotList_Stop">Zatrzymaj</x:String>
    <x:String x:Key="BotList_Download">Pobierz</x:String>
    <x:String x:Key="BotList_Update">Aktualizuj</x:String>
    <x:String x:Key="BotList_EmptyTitle">Nie znaleziono instancji</x:String>
    <x:String x:Key="BotList_EmptySubtitle">Zacznij od utworzenia nowej instancji bota.</x:String>
    <x:String x:Key="BotList_CreateInstance">Utwórz instancję</x:String>

    <!-- Bot View -->
    <x:String x:Key="BotView_BackToInstances">Powrót do instancji</x:String>
    <x:String x:Key="BotView_ChangeAvatarTip">Kliknij, aby zmienić avatar</x:String>
    <x:String x:Key="BotView_ClickToRenameTip">Kliknij, aby zmienić nazwę</x:String>
    <x:String x:Key="BotView_SaveTip">Zapisz</x:String>
    <x:String x:Key="BotView_CancelTip">Anuluj</x:String>
    <x:String x:Key="BotView_Configuration">Konfiguracja</x:String>
    <x:String x:Key="BotView_InstallPath">ŚCIEŻKA INSTALACJI</x:String>
    <x:String x:Key="BotView_Browse">Przeglądaj</x:String>
    <x:String x:Key="BotView_Actions">Akcje</x:String>
    <x:String x:Key="BotView_StopInstance">Zatrzymaj instancję</x:String>
    <x:String x:Key="BotView_Start">Uruchom</x:String>
    <x:String x:Key="BotView_DownloadInstall">Pobierz i zainstaluj</x:String>
    <x:String x:Key="BotView_CancelDownload">Anuluj pobieranie</x:String>
    <x:String x:Key="BotView_Shortcuts">Skróty</x:String>
    <x:String x:Key="BotView_DataFolder">Folder danych</x:String>
    <x:String x:Key="BotView_OpenInFileManager">Otwórz w menedżerze plików</x:String>
    <x:String x:Key="BotView_OpenConfiguration">Otwórz konfigurację</x:String>
    <x:String x:Key="BotView_DangerZone">STREFA ZAGROŻENIA</x:String>
    <x:String x:Key="BotView_DangerDescription">Usuwa tę instancję z Upeko. Pliki bota zostają na dysku, więc usuń jego folder samodzielnie, jeśli nie jest już potrzebny.</x:String>
    <x:String x:Key="BotView_DeleteInstance">Usuń instancję</x:String>
    <x:String x:Key="BotView_SelectBotPath">Wybierz ścieżkę bota</x:String>
    <x:String x:Key="BotView_SelectAvatarImage">Wybierz obraz avatara</x:String>
    <x:String x:Key="BotView_ImageFiles">Pliki graficzne</x:String>

    <!-- Status Text -->
    <x:String x:Key="Status_Running">Działa</x:String>
    <x:String x:Key="Status_Ready">Gotowy</x:String>
    <x:String x:Key="Status_UpdateAvailable">Dostępna aktualizacja</x:String>
    <x:String x:Key="Status_NotDownloaded">Nie pobrano</x:String>
    <x:String x:Key="Status_Unknown">Nieznany</x:String>

    <!-- Update Button -->
    <x:String x:Key="BotView_Checking">Sprawdzanie...</x:String>
    <x:String x:Key="BotView_UpdateButton">Aktualizuj</x:String>
    <x:String x:Key="BotView_CheckUpdates">Sprawdź aktualizacje</x:String>

    <!-- Download Progress -->
    <x:String x:Key="Progress_Downloading">Pobieranie...</x:String>
    <x:String x:Key="Progress_PleaseWait">Poczekaj i nie zamykaj aplikacji.</x:String>
    <x:String x:Key="Progress_Stalled">Brak postępu</x:String>
    <x:String x:Key="Progress_Calculating">Obliczanie...</x:String>

    <!-- Dependency Status -->

    <!-- Toast Messages -->
    <x:String x:Key="Toast_InstanceCreated">Instancja utworzona</x:String>
    <x:String x:Key="Toast_InstanceDeleted">Instancja usunięta</x:String>
    <x:String x:Key="Toast_RecoveredFromBackup">Ustawienia były uszkodzone i zostały przywrócone z kopii zapasowej</x:String>
    <x:String x:Key="Toast_ResumingBots">Uruchamianie botów z ostatniej sesji: {0}</x:String>

    <!-- Notices and errors -->
    <x:String x:Key="Modal_ExitMessage">Uruchomione boty: {0}. Zamknięcie Upeko je zatrzyma. Uruchomią się ponownie przy następnym otwarciu Upeko.</x:String>
    <x:String x:Key="Progress_DownloadingVersion">Pobieranie NadekoBot {0}...</x:String>
    <x:String x:Key="Progress_Extracting">Rozpakowywanie...</x:String>
    <x:String x:Key="Progress_Installing">Instalowanie...</x:String>
    <x:String x:Key="BotView_DiskSpace">potrzeba ~{0} · wolne {1}</x:String>
    <x:String x:Key="Dep_TipInstalled">{0} jest zainstalowany</x:String>
    <x:String x:Key="Dep_TipMissing">Brak {0}. Kliknij, aby zainstalować (potrzebne do muzyki).</x:String>
    <x:String x:Key="Dep_TipChecking">Sprawdzanie {0}...</x:String>
    <x:String x:Key="Toast_InstallingDep">Instalowanie {0}...</x:String>
    <x:String x:Key="Toast_DepInstalled">Zainstalowano {0}</x:String>
    <x:String x:Key="Toast_DepInstallFailed">Nie udało się zainstalować {0}. Szczegóły znajdziesz w logu.</x:String>
    <x:String x:Key="Toast_FfmpegMacBrew">Zainstaluj ffmpeg przez Homebrew: brew install ffmpeg</x:String>
    <x:String x:Key="Toast_StartFailed">Nie udało się uruchomić {0}: {1}</x:String>
    <x:String x:Key="Toast_BotExited">{0} nieoczekiwanie się zatrzymał</x:String>
    <x:String x:Key="Toast_CredsMissing">Nie znaleziono creds_example.yml. Najpierw pobierz bota.</x:String>
    <x:String x:Key="Toast_OpenFailed">Nie udało się otworzyć: {0}</x:String>
    <x:String x:Key="Toast_UpdateCheckFailed">Nie udało się sprawdzić aktualizacji: {0}</x:String>
    <x:String x:Key="Toast_UpToDate">NadekoBot jest aktualny</x:String>
    <x:String x:Key="Toast_StopBeforeUpdate">Zatrzymaj bota przed aktualizacją</x:String>
    <x:String x:Key="Toast_BotInstalled">{0} jest gotowy (v{1})</x:String>
    <x:String x:Key="Toast_DownloadCancelled">Pobieranie anulowane</x:String>
    <x:String x:Key="Toast_DownloadFailed">Pobieranie nie powiodło się: {0}</x:String>
    <x:String x:Key="Error_DownloadInProgress">Trwa już inne pobieranie. Poczekaj, aż się zakończy.</x:String>
    <x:String x:Key="Error_NoAssets">Najnowsze wydanie NadekoBot nie ma jeszcze plików do pobrania. Spróbuj później.</x:String>
    <x:String x:Key="Error_NoAssetForPlatform">Najnowsze wydanie NadekoBot nie ma wersji dla tego systemu ({0}).</x:String>
    <x:String x:Key="Error_RootFolder">Wybierz folder dla bota, a nie katalog główny dysku.</x:String>
    <x:String x:Key="Error_NotEnoughSpace">Za mało miejsca na dysku: potrzeba {0}, wolne {1}. Zwolnij miejsce lub wybierz inny folder.</x:String>
    <x:String x:Key="Error_Extract">Nie udało się rozpakować pobranego pliku: {0}</x:String>

    <!-- Patreon and NadeKloud -->
    <x:String x:Key="MainWindow_PatreonTip">Wesprzyj Nadeko na Patreonie</x:String>
    <x:String x:Key="MainWindow_CloudTip">NadeKloud: zarządzany hosting NadekoBot</x:String>
    <x:String x:Key="Cloud_Or">lub</x:String>
    <x:String x:Key="Cloud_CardTitle">Pozwól nam go hostować</x:String>
    <x:String x:Key="Cloud_CardText">NadeKloud uruchamia twojego własnego NadekoBota 24/7. Bez własnego serwera, a aktualizacjami i nocnymi kopiami zapasowymi zajmujemy się my. Darmowy okres próbny, bez karty.</x:String>
    <x:String x:Key="Cloud_TryFree">Wypróbuj za darmo</x:String>
    <x:String x:Key="Cloud_AdTag">Reklama</x:String>
    <x:String x:Key="Cloud_AdTip">NadeKloud prowadzi twórca Nadeko</x:String>
    <x:String x:Key="Footer_Support">Pomoc</x:String>
    <x:String x:Key="Footer_Donate">Wesprzyj</x:String>
    <x:String x:Key="Footer_Hosting">Hosting bota</x:String>

    <!-- Changelog -->
    <x:String x:Key="Changelog_WhatsNew">Co nowego</x:String>
    <x:String x:Key="Changelog_Title">Lista zmian NadekoBot</x:String>
    <x:String x:Key="Changelog_Since">Zmiany od v{0}</x:String>
    <x:String x:Key="Changelog_Latest">Najnowsza wersja</x:String>
    <x:String x:Key="Changelog_Loading">Wczytywanie listy zmian...</x:String>
    <x:String x:Key="Changelog_LoadFailed">Nie udało się wczytać listy zmian: {0}</x:String>
    <x:String x:Key="Changelog_OnGitHub">Pełna lista zmian na GitHubie</x:String>
    <x:String x:Key="Changelog_Close">Zamknij</x:String>
</ResourceDictionary>
