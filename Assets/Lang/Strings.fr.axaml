<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

    <!-- App / MainWindow -->
    <x:String x:Key="App_Name">Upeko</x:String>
    <x:String x:Key="MainWindow_Title">Upeko — Gestionnaire de Bots</x:String>
    <x:String x:Key="MainWindow_MinimizeToTrayTip">Réduire dans la zone de notification à la fermeture</x:String>
    <x:String x:Key="MainWindow_ToggleThemeTip">Changer de thème</x:String>
    <x:String x:Key="MainWindow_DiscordTip">Rejoindre le Discord Nadeko Bot</x:String>
    <x:String x:Key="MainWindow_NewerVersion">Nouvelle version</x:String>
    <x:String x:Key="MainWindow_NewerVersionTip">Cliquer pour télécharger la dernière version d'upeko</x:String>

    <!-- Delete Modal -->
    <x:String x:Key="Modal_DeleteTitle">Supprimer l'instance</x:String>
    <x:String x:Key="Modal_DeletePrefix">Êtes-vous sûr de vouloir supprimer </x:String>
    <x:String x:Key="Modal_DeleteSuffix"> ? Cette action est irréversible.</x:String>
    <x:String x:Key="Modal_Cancel">Annuler</x:String>
    <x:String x:Key="Modal_Delete">Supprimer</x:String>

    <!-- Exit Modal -->
    <x:String x:Key="Modal_ExitTitle">Des bots sont encore en cours d'exécution</x:String>
    <x:String x:Key="Modal_QuitAnyway">Quitter quand même</x:String>

    <!-- Tray -->
    <x:String x:Key="Tray_Show">Afficher Upeko</x:String>
    <x:String x:Key="Tray_Exit">Quitter</x:String>
    <x:String x:Key="Tray_Tooltip">Upeko</x:String>
    <x:String x:Key="Tray_MinimizedNotification">Upeko a été réduit dans la zone de notification et continuera de fonctionner en arrière-plan</x:String>

    <!-- Bot List View -->
    <x:String x:Key="BotList_PageTitle">Instances</x:String>
    <x:String x:Key="BotList_PageSubtitle">Gérez vos instances NadekoBot</x:String>
    <x:String x:Key="BotList_Changelog">Journal des modifications</x:String>
    <x:String x:Key="BotList_AddInstance">Ajouter une instance</x:String>
    <x:String x:Key="BotList_Start">Démarrer</x:String>
    <x:String x:Key="BotList_Stop">Arrêter</x:String>
    <x:String x:Key="BotList_Download">Télécharger</x:String>
    <x:String x:Key="BotList_Update">Mettre à jour</x:String>
    <x:String x:Key="BotList_EmptyTitle">Aucune instance trouvée</x:String>
    <x:String x:Key="BotList_EmptySubtitle">Commencez par créer une nouvelle instance de bot.</x:String>
    <x:String x:Key="BotList_CreateInstance">Créer une instance</x:String>

    <!-- Bot View -->
    <x:String x:Key="BotView_BackToInstances">Retour aux instances</x:String>
    <x:String x:Key="BotView_ChangeAvatarTip">Cliquer pour changer l'avatar</x:String>
    <x:String x:Key="BotView_ClickToRenameTip">Cliquer pour renommer</x:String>
    <x:String x:Key="BotView_SaveTip">Enregistrer</x:String>
    <x:String x:Key="BotView_CancelTip">Annuler</x:String>
    <x:String x:Key="BotView_Configuration">Configuration</x:String>
    <x:String x:Key="BotView_InstallPath">CHEMIN D'INSTALLATION</x:String>
    <x:String x:Key="BotView_Browse">Parcourir</x:String>
    <x:String x:Key="BotView_Actions">Actions</x:String>
    <x:String x:Key="BotView_StopInstance">Arrêter l'instance</x:String>
    <x:String x:Key="BotView_Start">Démarrer</x:String>
    <x:String x:Key="BotView_DownloadInstall">Télécharger et installer</x:String>
    <x:String x:Key="BotView_CancelDownload">Annuler le téléchargement</x:String>
    <x:String x:Key="BotView_Shortcuts">Raccourcis</x:String>
    <x:String x:Key="BotView_DataFolder">Dossier de données</x:String>
    <x:String x:Key="BotView_OpenInFileManager">Ouvrir dans le gestionnaire de fichiers</x:String>
    <x:String x:Key="BotView_OpenConfiguration">Ouvrir la configuration</x:String>
    <x:String x:Key="BotView_DangerZone">ZONE DE DANGER</x:String>
    <x:String x:Key="BotView_DangerDescription">Retire cette instance d'Upeko. Les fichiers du bot restent sur le disque : supprimez son dossier vous-même si vous n'en avez plus besoin.</x:String>
    <x:String x:Key="BotView_DeleteInstance">Supprimer l'instance</x:String>
    <x:String x:Key="BotView_SelectBotPath">Sélectionner le chemin du bot</x:String>
    <x:String x:Key="BotView_SelectAvatarImage">Sélectionner une image d'avatar</x:String>
    <x:String x:Key="BotView_ImageFiles">Fichiers image</x:String>

    <!-- Status Text -->
    <x:String x:Key="Status_Running">En cours</x:String>
    <x:String x:Key="Status_Ready">Prêt</x:String>
    <x:String x:Key="Status_UpdateAvailable">Mise à jour disponible</x:String>
    <x:String x:Key="Status_NotDownloaded">Non téléchargé</x:String>
    <x:String x:Key="Status_Unknown">Inconnu</x:String>

    <!-- Update Button -->
    <x:String x:Key="BotView_Checking">Vérification...</x:String>
    <x:String x:Key="BotView_UpdateButton">Mettre à jour</x:String>
    <x:String x:Key="BotView_CheckUpdates">Vérifier les mises à jour</x:String>

    <!-- Download Progress -->
    <x:String x:Key="Progress_Downloading">Téléchargement...</x:String>
    <x:String x:Key="Progress_PleaseWait">Veuillez patienter, ne fermez pas l'application.</x:String>
    <x:String x:Key="Progress_Stalled">Bloqué</x:String>
    <x:String x:Key="Progress_Calculating">Calcul...</x:String>

    <!-- Dependency Status -->

    <!-- Toast Messages -->
    <x:String x:Key="Toast_InstanceCreated">Instance créée</x:String>
    <x:String x:Key="Toast_InstanceDeleted">Instance supprimée</x:String>
    <x:String x:Key="Toast_RecoveredFromBackup">Les paramètres étaient endommagés et ont été restaurés depuis une sauvegarde</x:String>
    <x:String x:Key="Toast_ResumingBots">Démarrage des bots de la dernière session : {0}</x:String>

    <!-- Notices and errors -->
    <x:String x:Key="Modal_ExitMessage">Bots en cours d'exécution : {0}. Quitter Upeko les arrête. Ils redémarreront à la prochaine ouverture d'Upeko.</x:String>
    <x:String x:Key="Progress_DownloadingVersion">Téléchargement de NadekoBot {0}...</x:String>
    <x:String x:Key="Progress_Extracting">Extraction...</x:String>
    <x:String x:Key="Progress_Installing">Installation...</x:String>
    <x:String x:Key="BotView_DiskSpace">~{0} requis · {1} disponibles</x:String>
    <x:String x:Key="Dep_TipInstalled">{0} est installé</x:String>
    <x:String x:Key="Dep_TipMissing">{0} est manquant. Cliquez pour l'installer (nécessaire pour la musique).</x:String>
    <x:String x:Key="Dep_TipChecking">Vérification de {0}...</x:String>
    <x:String x:Key="Toast_InstallingDep">Installation de {0}...</x:String>
    <x:String x:Key="Toast_DepInstalled">{0} installé</x:String>
    <x:String x:Key="Toast_DepInstallFailed">Impossible d'installer {0}. Consultez le journal pour plus de détails.</x:String>
    <x:String x:Key="Toast_FfmpegMacBrew">Installez ffmpeg avec Homebrew : brew install ffmpeg</x:String>
    <x:String x:Key="Toast_StartFailed">Impossible de démarrer {0} : {1}</x:String>
    <x:String x:Key="Toast_BotExited">{0} s'est arrêté de façon inattendue</x:String>
    <x:String x:Key="Toast_CredsMissing">creds_example.yml est introuvable. Téléchargez d'abord le bot.</x:String>
    <x:String x:Key="Toast_OpenFailed">Impossible d'ouvrir : {0}</x:String>
    <x:String x:Key="Toast_UpdateCheckFailed">Impossible de rechercher les mises à jour : {0}</x:String>
    <x:String x:Key="Toast_UpToDate">NadekoBot est à jour</x:String>
    <x:String x:Key="Toast_StopBeforeUpdate">Arrêtez le bot avant de le mettre à jour</x:String>
    <x:String x:Key="Toast_BotInstalled">{0} est prêt (v{1})</x:String>
    <x:String x:Key="Toast_DownloadCancelled">Téléchargement annulé</x:String>
    <x:String x:Key="Toast_DownloadFailed">Échec du téléchargement : {0}</x:String>
    <x:String x:Key="Error_DownloadInProgress">Un autre téléchargement est en cours. Attendez qu'il se termine.</x:String>
    <x:String x:Key="Error_NoAssets">La dernière version de NadekoBot n'a pas encore de fichiers à télécharger. Réessayez plus tard.</x:String>
    <x:String x:Key="Error_NoAssetForPlatform">La dernière version de NadekoBot n'a pas de build pour ce système ({0}).</x:String>
    <x:String x:Key="Error_RootFolder">Choisissez un dossier pour le bot, pas la racine d'un disque.</x:String>
    <x:String x:Key="Error_NotEnoughSpace">Espace disque insuffisant : {0} requis, {1} disponibles. Libérez de l'espace ou choisissez un autre dossier.</x:String>
    <x:String x:Key="Error_Extract">Impossible d'extraire le fichier téléchargé : {0}</x:String>

    <!-- Patreon and NadeKloud -->
    <x:String x:Key="MainWindow_PatreonTip">Soutenir Nadeko sur Patreon</x:String>
    <x:String x:Key="MainWindow_CloudTip">NadeKloud : hébergement NadekoBot géré</x:String>
    <x:String x:Key="Cloud_Or">ou</x:String>
    <x:String x:Key="Cloud_CardTitle">Laissez-nous l'héberger</x:String>
    <x:String x:Key="Cloud_CardText">NadeKloud fait tourner votre propre NadekoBot 24 h/24. Aucun serveur à gérer : les mises à jour et les sauvegardes nocturnes sont prises en charge. Essai gratuit, sans carte.</x:String>
    <x:String x:Key="Cloud_TryFree">Essayer gratuitement</x:String>
    <x:String x:Key="Cloud_AdTag">Pub</x:String>
    <x:String x:Key="Cloud_AdTip">NadeKloud est géré par le développeur de Nadeko</x:String>
</ResourceDictionary>
