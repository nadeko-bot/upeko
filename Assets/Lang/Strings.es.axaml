<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="using:System">

    <!-- App / MainWindow -->
    <x:String x:Key="App_Name">Upeko</x:String>
    <x:String x:Key="MainWindow_Title">Upeko — Gestor de Bots</x:String>
    <x:String x:Key="MainWindow_MinimizeToTrayTip">Minimizar a la bandeja al cerrar</x:String>
    <x:String x:Key="MainWindow_ToggleThemeTip">Cambiar tema</x:String>
    <x:String x:Key="MainWindow_DiscordTip">Unirse al Discord de Nadeko Bot</x:String>
    <x:String x:Key="MainWindow_NewerVersion">Nueva versión</x:String>
    <x:String x:Key="MainWindow_NewerVersionTip">Haz clic para descargar la última versión de Upeko</x:String>

    <!-- Delete Modal -->
    <x:String x:Key="Modal_DeleteTitle">Eliminar instancia</x:String>
    <x:String x:Key="Modal_DeletePrefix">¿Estás seguro de que quieres eliminar </x:String>
    <x:String x:Key="Modal_DeleteSuffix">? Esta acción no se puede deshacer.</x:String>
    <x:String x:Key="Modal_Cancel">Cancelar</x:String>
    <x:String x:Key="Modal_Delete">Eliminar</x:String>

    <!-- Exit Modal -->
    <x:String x:Key="Modal_ExitTitle">Los bots siguen ejecutándose</x:String>
    <x:String x:Key="Modal_QuitAnyway">Salir de todos modos</x:String>

    <!-- Tray -->
    <x:String x:Key="Tray_Show">Mostrar Upeko</x:String>
    <x:String x:Key="Tray_Exit">Salir</x:String>
    <x:String x:Key="Tray_Tooltip">Upeko</x:String>
    <x:String x:Key="Tray_MinimizedNotification">Upeko se ha movido a la bandeja del sistema y seguirá ejecutándose en segundo plano</x:String>

    <!-- Bot List View -->
    <x:String x:Key="BotList_PageTitle">Instancias</x:String>
    <x:String x:Key="BotList_PageSubtitle">Administra tus instancias de NadekoBot</x:String>
    <x:String x:Key="BotList_Changelog">Registro de cambios</x:String>
    <x:String x:Key="BotList_AddInstance">Agregar instancia</x:String>
    <x:String x:Key="BotList_Start">Iniciar</x:String>
    <x:String x:Key="BotList_Stop">Detener</x:String>
    <x:String x:Key="BotList_Download">Descargar</x:String>
    <x:String x:Key="BotList_Update">Actualizar</x:String>
    <x:String x:Key="BotList_EmptyTitle">No se encontraron instancias</x:String>
    <x:String x:Key="BotList_EmptySubtitle">Comienza creando una nueva instancia de bot.</x:String>
    <x:String x:Key="BotList_CreateInstance">Crear instancia</x:String>

    <!-- Bot View -->
    <x:String x:Key="BotView_BackToInstances">Volver a las instancias</x:String>
    <x:String x:Key="BotView_ChangeAvatarTip">Haz clic para cambiar el avatar</x:String>
    <x:String x:Key="BotView_ClickToRenameTip">Haz clic para renombrar</x:String>
    <x:String x:Key="BotView_SaveTip">Guardar</x:String>
    <x:String x:Key="BotView_CancelTip">Cancelar</x:String>
    <x:String x:Key="BotView_Configuration">Configuración</x:String>
    <x:String x:Key="BotView_InstallPath">RUTA DE INSTALACIÓN</x:String>
    <x:String x:Key="BotView_Browse">Examinar</x:String>
    <x:String x:Key="BotView_Actions">Acciones</x:String>
    <x:String x:Key="BotView_StopInstance">Detener instancia</x:String>
    <x:String x:Key="BotView_Start">Iniciar</x:String>
    <x:String x:Key="BotView_DownloadInstall">Descargar e instalar</x:String>
    <x:String x:Key="BotView_CancelDownload">Cancelar descarga</x:String>
    <x:String x:Key="BotView_Shortcuts">Accesos directos</x:String>
    <x:String x:Key="BotView_DataFolder">Carpeta de datos</x:String>
    <x:String x:Key="BotView_OpenInFileManager">Abrir en el explorador de archivos</x:String>
    <x:String x:Key="BotView_OpenConfiguration">Abrir configuración</x:String>
    <x:String x:Key="BotView_DangerZone">ZONA DE PELIGRO</x:String>
    <x:String x:Key="BotView_DangerDescription">Quita esta instancia de Upeko. Los archivos del bot se quedan en el disco; borra su carpeta si ya no la necesitas.</x:String>
    <x:String x:Key="BotView_DeleteInstance">Eliminar instancia</x:String>
    <x:String x:Key="BotView_SelectBotPath">Seleccionar ruta del bot</x:String>
    <x:String x:Key="BotView_SelectAvatarImage">Seleccionar imagen de avatar</x:String>
    <x:String x:Key="BotView_ImageFiles">Archivos de imagen</x:String>

    <!-- Status Text -->
    <x:String x:Key="Status_Running">En ejecución</x:String>
    <x:String x:Key="Status_Ready">Listo</x:String>
    <x:String x:Key="Status_UpdateAvailable">Actualización disponible</x:String>
    <x:String x:Key="Status_NotDownloaded">No descargado</x:String>
    <x:String x:Key="Status_Unknown">Desconocido</x:String>

    <!-- Update Button -->
    <x:String x:Key="BotView_Checking">Verificando...</x:String>
    <x:String x:Key="BotView_UpdateButton">Actualizar</x:String>
    <x:String x:Key="BotView_CheckUpdates">Buscar actualizaciones</x:String>

    <!-- Download Progress -->
    <x:String x:Key="Progress_Downloading">Descargando...</x:String>
    <x:String x:Key="Progress_PleaseWait">Espera, no cierres la aplicación.</x:String>
    <x:String x:Key="Progress_Stalled">Sin progreso</x:String>
    <x:String x:Key="Progress_Calculating">Calculando...</x:String>

    <!-- Dependency Status -->

    <!-- Toast Messages -->
    <x:String x:Key="Toast_InstanceCreated">Instancia creada</x:String>
    <x:String x:Key="Toast_InstanceDeleted">Instancia eliminada</x:String>
    <x:String x:Key="Toast_RecoveredFromBackup">La configuración estaba dañada y se restauró desde una copia de seguridad</x:String>
    <x:String x:Key="Toast_ResumingBots">Iniciando los bots de la última sesión: {0}</x:String>

    <!-- Notices and errors -->
    <x:String x:Key="Modal_ExitMessage">Bots en ejecución: {0}. Si cierras Upeko, se detendrán. Volverán a iniciarse la próxima vez que abras Upeko.</x:String>
    <x:String x:Key="Progress_DownloadingVersion">Descargando NadekoBot {0}...</x:String>
    <x:String x:Key="Progress_Extracting">Extrayendo...</x:String>
    <x:String x:Key="Progress_Installing">Instalando...</x:String>
    <x:String x:Key="BotView_DiskSpace">~{0} necesarios · {1} libres</x:String>
    <x:String x:Key="Dep_TipInstalled">{0} está instalado</x:String>
    <x:String x:Key="Dep_TipMissing">Falta {0}. Haz clic para instalarlo (necesario para la música).</x:String>
    <x:String x:Key="Dep_TipChecking">Comprobando {0}...</x:String>
    <x:String x:Key="Toast_InstallingDep">Instalando {0}...</x:String>
    <x:String x:Key="Toast_DepInstalled">{0} instalado</x:String>
    <x:String x:Key="Toast_DepInstallFailed">No se pudo instalar {0}. Consulta el registro para más detalles.</x:String>
    <x:String x:Key="Toast_FfmpegMacBrew">Instala ffmpeg con Homebrew: brew install ffmpeg</x:String>
    <x:String x:Key="Toast_StartFailed">No se pudo iniciar {0}: {1}</x:String>
    <x:String x:Key="Toast_BotExited">{0} se detuvo inesperadamente</x:String>
    <x:String x:Key="Toast_CredsMissing">No se encontró creds_example.yml. Descarga primero el bot.</x:String>
    <x:String x:Key="Toast_OpenFailed">No se pudo abrir: {0}</x:String>
    <x:String x:Key="Toast_UpdateCheckFailed">No se pudieron buscar actualizaciones: {0}</x:String>
    <x:String x:Key="Toast_UpToDate">NadekoBot está actualizado</x:String>
    <x:String x:Key="Toast_StopBeforeUpdate">Detén el bot antes de actualizarlo</x:String>
    <x:String x:Key="Toast_BotInstalled">{0} está listo (v{1})</x:String>
    <x:String x:Key="Toast_DownloadCancelled">Descarga cancelada</x:String>
    <x:String x:Key="Toast_DownloadFailed">Error en la descarga: {0}</x:String>
    <x:String x:Key="Error_DownloadInProgress">Ya hay otra descarga en curso. Espera a que termine.</x:String>
    <x:String x:Key="Error_NoAssets">La última versión de NadekoBot aún no tiene descargas. Inténtalo más tarde.</x:String>
    <x:String x:Key="Error_NoAssetForPlatform">La última versión de NadekoBot no tiene una compilación para este sistema ({0}).</x:String>
    <x:String x:Key="Error_RootFolder">Elige una carpeta para el bot, no la raíz de una unidad.</x:String>
    <x:String x:Key="Error_NotEnoughSpace">No hay suficiente espacio en disco: se necesitan {0} y hay {1} libres. Libera espacio o elige otra carpeta.</x:String>
    <x:String x:Key="Error_Extract">No se pudo extraer la descarga: {0}</x:String>

    <!-- Patreon and NadeKloud -->
    <x:String x:Key="MainWindow_PatreonTip">Apoya a Nadeko en Patreon</x:String>
    <x:String x:Key="MainWindow_CloudTip">NadeKloud: alojamiento gestionado de NadekoBot</x:String>
    <x:String x:Key="Cloud_Or">o</x:String>
    <x:String x:Key="Cloud_CardTitle">Deja que lo alojemos</x:String>
    <x:String x:Key="Cloud_CardText">NadeKloud ejecuta tu propio NadekoBot 24/7. Sin servidor que mantener: nos encargamos de las actualizaciones y las copias de seguridad nocturnas. Prueba gratis, sin tarjeta.</x:String>
    <x:String x:Key="Cloud_TryFree">Pruébalo gratis</x:String>
    <x:String x:Key="Cloud_AdTag">Anuncio</x:String>
    <x:String x:Key="Cloud_AdTip">NadeKloud lo gestiona el desarrollador de Nadeko</x:String>
    <x:String x:Key="Footer_Support">Soporte</x:String>
    <x:String x:Key="Footer_Donate">Donar</x:String>
    <x:String x:Key="Footer_Hosting">Alojamiento</x:String>
</ResourceDictionary>
